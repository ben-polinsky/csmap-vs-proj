# Copy this to fly.toml after `fly launch --no-deploy`, then set the real app
# name and preferred primary region generated for the Fly organization.
app = "csmap-vs-proj-example"
primary_region = "iad"

[build]
  dockerfile = "Dockerfile"

[env]
  HOST = "0.0.0.0"
  PORT = "4173"
  PROJ_DATA = "/usr/share/proj"
  PROJ_NETWORK = "OFF"
  COMPARE_CONCURRENCY = "2"
  COMPARE_QUEUE_LIMIT = "16"

[http_service]
  internal_port = 4173
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0
  processes = ["app"]

[http_service.concurrency]
  type = "requests"
  soft_limit = 8
  hard_limit = 16

[[http_service.checks]]
  grace_period = "30s"
  interval = "30s"
  method = "GET"
  timeout = "5s"
  path = "/api/health"

[[vm]]
  cpu_kind = "shared"
  cpus = 1
  memory_mb = 512
